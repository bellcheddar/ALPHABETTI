# ALPHABETTI environment. Copy to .env and fill in. Never commit .env.

# ---- Where the fold happens -------------------------------------------------
# hf_space  a Hugging Face ZeroGPU Space holds ESMFold and ESM-2 (production)
# local     torch + transformers in this process (needs ~16 GB RAM, used to
#           bulk pre-warm the cache from a machine that has the weights)
# none      cache only; a miss is refused with a clear message
ALPHABETTI_FOLD_BACKEND=hf_space
ALPHABETTI_HF_SPACE=Dellboy/alphabetti-fold

# Required in practice. The anonymous ZeroGPU quota is a handful of folds and
# runs out with an error that does not mention quota.
HF_TOKEN=

# ---- Flask ------------------------------------------------------------------
ALPHABETTI_ENV=production
ALPHABETTI_SECRET_KEY=

# ---- Limits -----------------------------------------------------------------
ALPHABETTI_MAX_LENGTH=400
ALPHABETTI_MIN_LENGTH=10
ALPHABETTI_FOLD_TIMEOUT=900
ALPHABETTI_MAX_CONCURRENT=2
ALPHABETTI_TOP_K=6

# ---- Paths ------------------------------------------------------------------
ALPHABETTI_CACHE=/opt/alphabetti/instance/alphabetti.sqlite
# Keep model weights off the boot volume and out of a per-restart temp dir.
HF_HOME=/opt/alphabetti/hf

# ---- Outbound ---------------------------------------------------------------
ALPHABETTI_ENABLE_UNIPROT=1
ALPHABETTI_ENABLE_VARIANTS=1
ALPHABETTI_UNIPROT_TIMEOUT=12
